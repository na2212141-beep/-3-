<!DOCTYPE html><html><head><style>body{margin:0;overflow:hidden;background:#87CEEB;font-family:Arial,sans-serif}#ui{position:absolute;top:15px;left:15px;color:#fff;font-size:18px;font-weight:bold;text-shadow:2px 2px 0 #000;pointer-events:none;background:rgba(0,0,0,.5);padding:10px;border-radius:10px}#msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;font-size:40px;font-weight:bold;text-shadow:3px 3px 0 #000;display:none;text-align:center}</style></head><body><div id="ui">Уровень: 1<br>Заказы: 0/5<br>Статус: Ищите ресторан (Желтый куб)</div><div id="msg"></div><script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script><script>const scene=new THREE.Scene();scene.background=new THREE.Color(0x87CEEB);scene.fog=new THREE.Fog(0x87CEEB,20,100);const camera=new THREE.PerspectiveCamera(60,innerWidth/innerHeight,0.1,1000);const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(innerWidth,innerHeight);renderer.shadowMap.enabled=true;document.body.appendChild(renderer.domElement);const hemiLight=new THREE.HemisphereLight(0xffffff,0x444444,0.8);scene.add(hemiLight);const dirLight=new THREE.DirectionalLight(0xffffff,0.8);dirLight.position.set(20,40,20);dirLight.castShadow=true;dirLight.shadow.mapSize.width=2048;dirLight.shadow.mapSize.height=2048;dirLight.shadow.camera.left=-50;dirLight.shadow.camera.right=50;dirLight.shadow.camera.top=50;dirLight.shadow.camera.bottom=-50;scene.add(dirLight);const ground=new THREE.Mesh(new THREE.PlaneGeometry(200,200),new THREE.MeshLambertMaterial({color:0x556B2F}));ground.rotation.x=-Math.PI/2;ground.receiveShadow=true;scene.add(ground);const roads=new THREE.Group();scene.add(roads);for(let i=-4;i<=4;i++){let roadV=new THREE.Mesh(new THREE.PlaneGeometry(10,200),new THREE.MeshLambertMaterial({color:0x333333}));roadV.rotation.x=-Math.PI/2;roadV.position.set(i*20,0.01,0);roadV.receiveShadow=true;roads.add(roadV);let roadH=new THREE.Mesh(new THREE.PlaneGeometry(200,10),new THREE.MeshLambertMaterial({color:0x333333}));roadH.rotation.x=-Math.PI/2;roadH.position.set(0,0.01,i*20);roadH.receiveShadow=true;roads.add(roadH)}const buildings=new THREE.Group();scene.add(buildings);function createBuilding(x,z){const h=Math.random()*15+10;const w=Math.random()*8+6;const d=Math.random()*8+6;const b=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshLambertMaterial({color:new THREE.Color().setHSL(Math.random(),0.5,0.5)}));b.position.set(x,h/2,z);b.castShadow=true;b.receiveShadow=true;buildings.add(b)}for(let i=-4;i<=4;i++){for(let j=-4;j<=4;j++){if(i===0||j===0)continue;if(Math.random()>0.3)createBuilding(i*20+(Math.random()-0.5)*4,j*20+(Math.random()-0.5)*4)}}const playerGroup=new THREE.Group();scene.add(playerGroup);const bodyMat=new THREE.MeshLambertMaterial({color:0xFF4500});const body=new THREE.Mesh(new THREE.BoxGeometry(1.5,1,2),bodyMat);body.position.y=0.5;body.castShadow=true;playerGroup.add(body);const boxMat=new THREE.MeshLambertMaterial({color:0x8B4513});const box=new THREE.Mesh(new THREE.BoxGeometry(1.2,1.2,1.2),boxMat);box.position.set(0,1.6,-0.5);box.castShadow=true;playerGroup.add(box);const headMat=new THREE.MeshLambertMaterial({color:0xFFDAB9});const head=new THREE.Mesh(new THREE.SphereGeometry(0.4,16,16),headMat);head.position.set(0,1.5,0.5);head.castShadow=true;playerGroup.add(head);playerGroup.position.set(0,0,0);let keys={};document.addEventListener('keydown',e=>keys[e.code]=true);document.addEventListener('keyup',e=>keys[e.code]=false);let velocity=new THREE.Vector3();let targetObj=null;let isCarrying=false;let score=0;let level=1;let maxScore=5;let speedMultiplier=1;const targetRingGeo=new THREE.RingGeometry(1.5,2,32);const targetRingMat=new THREE.MeshBasicMaterial({color:0xFFFF00,side:THREE.DoubleSide,transparent:true,opacity:0.8});const targetRing=new THREE.Mesh(targetRingGeo,targetRingMat);targetRing.rotation.x=-Math.PI/2;targetRing.position.y=0.05;scene.add(targetRing);const particles=[];function createParticles(pos,color){const pMat=new THREE.MeshBasicMaterial({color:color});for(let i=0;i<10;i++){const p=new THREE.Mesh(new THREE.BoxGeometry(0.3,0.3,0.3),pMat);p.position.copy(pos);p.velocity=new THREE.Vector3((Math.random()-0.5)*10,Math.random()*10,(Math.random()-0.5)*10);scene.add(p);particles.push(p)}}function spawnPickup(){if(targetObj)scene.remove(targetObj);targetObj=new THREE.Group();const rest=new THREE.Mesh(new THREE.BoxGeometry(4,4,4),new THREE.MeshLambertMaterial({color:0xFFD700}));rest.position.y=2;rest.castShadow=true;targetObj.add(rest);const sign=new THREE.Mesh(new THREE.BoxGeometry(4.2,1,4.2),new THREE.MeshBasicMaterial({color:0xFF0000}));sign.position.y=4.5;targetObj.add(sign);targetObj.position.set((Math.floor(Math.random()*7)-3)*20,0,(Math.floor(Math.random()*7)-3)*20);if(targetObj.position.length()<10)targetObj.position.multiplyScalar(2);scene.add(targetObj);targetRing.material.color.setHex(0xFFFF00);isCarrying=false;updateUI()}function spawnDropoff(){if(targetObj)scene.remove(targetObj);targetObj=new THREE.Group();const house=new THREE.Mesh(new THREE.BoxGeometry(5,5,5),new THREE.MeshLambertMaterial({color:0x00BFFF}));house.position.y=2.5;house.castShadow=true;targetObj.add(house);targetObj.position.set((Math.floor(Math.random()*7)-3)*20,0,(Math.floor(Math.random()*7)-3)*20);if(targetObj.position.distanceTo(playerGroup.position)<15)targetObj.position.multiplyScalar(-1);scene.add(targetObj);targetRing.material.color.setHex(0x00FF00);isCarrying=true;updateUI()}function updateUI(){document.getElementById('ui').innerHTML=`Уровень: ${level}<br>Заказы: ${score}/${maxScore}<br>Статус: ${isCarrying?'Доставьте заказ в синий дом':'Возьмите заказ в желтом ресторане'}`}function showMsg(text){const msg=document.getElementById('msg');msg.innerText=text;msg.style.display='block';setTimeout(()=>msg.style.display='none',2000)}spawnPickup();let clock=new THREE.Clock();function animate(){requestAnimationFrame(animate);const delta=clock.getDelta();const speed=20*speedMultiplier;const friction=0.85;if(keys['KeyW']||keys['ArrowUp'])velocity.z-=speed*delta;if(keys['KeyS']||keys['ArrowDown'])velocity.z+=speed*delta;if(keys['KeyA']||keys['ArrowLeft'])velocity.x-=speed*delta;if(keys['KeyD']||keys['ArrowRight'])velocity.x+=speed*delta;velocity.multiplyScalar(friction);playerGroup.position.add(velocity);if(velocity.length()>0.1){const angle=Math.atan2(velocity.x,velocity.z);playerGroup.rotation.y=angle}playerGroup.position.x=THREE.MathUtils.clamp(playerGroup.position.x,-90,90);playerGroup.position.z=THREE.MathUtils.clamp(playerGroup.position.z,-90,90);const camOffset=new THREE.Vector3(0,10,-15);camOffset.applyQuaternion(playerGroup.quaternion);const camTarget=playerGroup.position.clone().add(camOffset);camera.position.lerp(camTarget,0.1);camera.lookAt(playerGroup.position.x,playerGroup.position.y+2,playerGroup.position.z);if(targetObj){targetRing.position.x=targetObj.position.x;targetRing.position.z=targetObj.position.z;targetRing.rotation.z+=delta*2;targetObj.rotation.y+=delta*0.5;const dist=playerGroup.position.distanceTo(targetObj.position);if(dist<4){if(!isCarrying){createParticles(targetObj.position,0xFFD700);spawnDropoff();showMsg("Заказ взят!")}else{createParticles(targetObj.position,0x00FF00);score++;showMsg("Доставлено!");if(score>=maxScore){if(level===1){level=2;maxScore=10;speedMultiplier=1.5;score=0;showMsg("ПЕРВОЕ ПЕРЕРОЖДЕНИЕ!\nСкорость x1.5")}else if(level===2){level=3;maxScore=15;speedMultiplier=2;score=0;showMsg("ВТОРОЕ ПЕРЕРОЖДЕНИЕ!\nСкорость x2.0")}else{level=1;maxScore=5;speedMultiplier=1;score=0;showMsg("МАКСИМУМ ДОСТИГНУТ!\nПОЛНОЕ ОБНУЛЕНИЕ")}}spawnPickup()}}}for(let i=particles.length-1;i>=0;i--){let p=particles[i];p.position.add(p.velocity.clone().multiplyScalar(delta));p.velocity.y-=20*delta;p.scale.multiplyScalar(0.95);if(p.scale.x<0.05){scene.remove(p);particles.splice(i,1)}}renderer.render(scene,camera)}animate();window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)});</script></body></html>
